{
  "name": "@veyra/sdk",
  "version": "0.1.0",
  "private": false,
  "description": "Typed client for the authenticated Veyra local API",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Ontixa/veyra/tree/main/packages/sdk-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ontixa/veyra.git",
    "directory": "packages/sdk-typescript"
  },
  "bugs": {
    "url": "https://github.com/Ontixa/veyra/issues"
  },
  "keywords": [
    "veyra",
    "ai-agents",
    "reversible-execution",
    "typescript",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "example:build": "tsc -p tsconfig.examples.json",
    "example:lifecycle": "node examples/run-lifecycle.mjs",
    "example:mcp": "node examples/run-mcp-interception.mjs",
    "example:a2a": "node examples/run-a2a-receipts.mjs",
    "example:test": "node --test examples/acceptance.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
